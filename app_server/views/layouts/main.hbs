<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{#if title}}{{title}} · {{/if}}Sea Sound Resort</title>

  <!-- CSS is directly in app-public/ -->
  <link rel="stylesheet" href="/style.css" />

  <!-- Some inline defaults so it looks decent even before CSS -->
  <style>
    body { margin:0; font-family:Arial, sans-serif; }
    header, footer { padding:1rem 0; background:#f8f8f8; }
    nav a { margin-right:1rem; text-decoration:none; color:#333; }
    nav a:hover { text-decoration:underline; }
    .container { max-width:1100px; margin:0 auto; padding:0 1rem; }
    img { max-width:100%; height:auto; display:block; }
  </style>
</head>
<body>
  <header>
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;">
      <!-- Logo (directly in app-public/) -->
      <a href="/"><img src="/logo.png" alt="Sea Sound Resort Logo" style="height:56px" /></a>
      <nav>
        <a href="/">Home</a>
        <a href="/rooms">Rooms</a>
        <a href="/about">About</a>
        <a href="/travel">Travel</a>
        <a href="/meals">Meals</a>
        <a href="/news">News</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </header>

  <main class="container">
    {{{body}}}
  </main>

  <footer>
    <div class="container">
      <p>&copy; {{year}} Sea Sound Resort</p>
    </div>
  </footer>
</body>
</html>
